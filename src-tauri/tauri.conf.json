{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "m8s",
  "version": "0.1.0",
  "identifier": "dev.joabzzz.m8s-app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "m8s"
        ]
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
